{"slug":"design-studio","storedAt":"2026-03-18T06:28:38.247Z","files":[{"path":"index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Atelier — Design Studio</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:wght@400;700&display=swap');\n\n*{margin:0;padding:0;box-sizing:border-box}\nbody{font-family:'Inter',sans-serif;background:#0a0a0a;color:#f5f5f0;overflow-x:hidden}\na{text-decoration:none;color:inherit}\n\nnav{position:fixed;top:0;width:100%;padding:24px 48px;display:flex;justify-content:space-between;align-items:center;z-index:100;backdrop-filter:blur(20px);background:rgba(10,10,10,0.7)}\nnav .logo{font-family:'Playfair Display',serif;font-size:24px;font-weight:700;letter-spacing:2px}\nnav ul{list-style:none;display:flex;gap:32px}\nnav ul li a{font-size:14px;font-weight:300;letter-spacing:1px;text-transform:uppercase;opacity:0.7;transition:opacity 0.3s}\nnav ul li a:hover{opacity:1}\n.btn-contact{border:1px solid rgba(245,245,240,0.3);padding:10px 24px;border-radius:24px;font-size:13px;letter-spacing:1px;text-transform:uppercase;transition:all 0.3s}\n.btn-contact:hover{background:#f5f5f0;color:#0a0a0a}\n\n.hero{height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:0 24px;position:relative}\n.hero::before{content:'';position:absolute;width:600px;height:600px;background:radial-gradient(circle,rgba(180,140,255,0.15),transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}\n.hero h1{font-family:'Playfair Display',serif;font-size:clamp(48px,8vw,120px);line-height:1.05;margin-bottom:24px;font-weight:400}\n.hero h1 em{font-style:italic;color:#c4a0ff}\n.hero p{font-size:18px;font-weight:300;opacity:0.6;max-width:500px;line-height:1.6;margin-bottom:40px}\n.hero .cta{display:inline-flex;align-items:center;gap:12px;background:#f5f5f0;color:#0a0a0a;padding:16px 36px;border-radius:32px;font-weight:600;font-size:14px;letter-spacing:1px;text-transform:uppercase;transition:transform 0.3s,box-shadow 0.3s}\n.hero .cta:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(196,160,255,0.3)}\n\n.work{padding:120px 48px}\n.work h2{font-family:'Playfair Display',serif;font-size:48px;margin-bottom:64px;text-align:center}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;max-width:1200px;margin:0 auto}\n.card{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:4/3;cursor:pointer;background:#1a1a1a}\n.card img{width:100%;height:100%;object-fit:cover;transition:transform 0.6s;opacity:0.85}\n.card:hover img{transform:scale(1.05);opacity:1}\n.card .overlay{position:absolute;bottom:0;left:0;right:0;padding:32px;background:linear-gradient(transparent,rgba(0,0,0,0.8))}\n.card .overlay h3{font-family:'Playfair Display',serif;font-size:22px;margin-bottom:4px}\n.card .overlay span{font-size:13px;opacity:0.6;text-transform:uppercase;letter-spacing:1px}\n\n.services{padding:120px 48px;text-align:center}\n.services h2{font-family:'Playfair Display',serif;font-size:48px;margin-bottom:64px}\n.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:40px;max-width:1000px;margin:0 auto}\n.service-item{padding:40px;border:1px solid rgba(245,245,240,0.1);border-radius:16px;transition:border-color 0.3s,transform 0.3s}\n.service-item:hover{border-color:rgba(196,160,255,0.4);transform:translateY(-4px)}\n.service-item .icon{font-size:36px;margin-bottom:20px}\n.service-item h3{font-size:20px;margin-bottom:12px;font-weight:600}\n.service-item p{font-size:14px;line-height:1.7;opacity:0.5;font-weight:300}\n\n.contact{padding:120px 48px;text-align:center}\n.contact h2{font-family:'Playfair Display',serif;font-size:clamp(36px,5vw,64px);margin-bottom:16px}\n.contact p{opacity:0.5;font-size:16px;margin-bottom:40px}\n.contact a.big-btn{display:inline-block;background:linear-gradient(135deg,#c4a0ff,#7b61ff);color:#fff;padding:18px 48px;border-radius:32px;font-weight:600;font-size:16px;letter-spacing:1px;transition:transform 0.3s,box-shadow 0.3s}\n.contact a.big-btn:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(123,97,255,0.4)}\n\nfooter{padding:48px;text-align:center;opacity:0.3;font-size:13px;border-top:1px solid rgba(245,245,240,0.08)}\n\n@media(max-width:768px){\n  nav{padding:16px 20px}\n  nav ul{display:none}\n  .work,.services,.contact{padding:80px 20px}\n  .grid{grid-template-columns:1fr}\n}\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"logo\">ATELIER</div>\n  <ul>\n    <li><a href=\"#work\">Work</a></li>\n    <li><a href=\"#services\">Services</a></li>\n    <li><a href=\"#contact\">Contact</a></li>\n  </ul>\n  <a href=\"#contact\" class=\"btn-contact\">Get in Touch</a>\n</nav>\n\n<section class=\"hero\">\n  <h1>We craft<br><em>digital</em> experiences</h1>\n  <p>A boutique design studio specializing in brand identity, digital products, and immersive web experiences.</p>\n  <a href=\"#work\" class=\"cta\">View Our Work &rarr;</a>\n</section>\n\n<section class=\"work\" id=\"work\">\n  <h2>Selected Work</h2>\n  <div class=\"grid\">\n    <div class=\"card\">\n      <img src=\"https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=600&h=450&fit=crop\" alt=\"Project\">\n      <div class=\"overlay\"><h3>Lumina Brand</h3><span>Branding &bull; 2024</span></div>\n    </div>\n    <div class=\"card\">\n      <img src=\"https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=600&h=450&fit=crop\" alt=\"Project\">\n      <div class=\"overlay\"><h3>Vertex App</h3><span>UI/UX &bull; 2024</span></div>\n    </div>\n    <div class=\"card\">\n      <img src=\"https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600&h=450&fit=crop\" alt=\"Project\">\n      <div class=\"overlay\"><h3>Nova Identity</h3><span>Visual Design &bull; 2023</span></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"services\" id=\"services\">\n  <h2>What We Do</h2>\n  <div class=\"services-grid\">\n    <div class=\"service-item\">\n      <div class=\"icon\">♦</div>\n      <h3>Brand Identity</h3>\n      <p>Crafting memorable brands that resonate with your audience and stand the test of time.</p>\n    </div>\n    <div class=\"service-item\">\n      <div class=\"icon\">◎</div>\n      <h3>UI/UX Design</h3>\n      <p>Intuitive digital experiences that delight users and drive measurable results.</p>\n    </div>\n    <div class=\"service-item\">\n      <div class=\"icon\">◫</div>\n      <h3>Web Development</h3>\n      <p>Pixel-perfect, performant websites built with modern technologies.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"contact\" id=\"contact\">\n  <h2>Let's create something<br>extraordinary together</h2>\n  <p>Ready to elevate your brand? We'd love to hear from you.</p>\n  <a href=\"mailto:hello@atelier.studio\" class=\"big-btn\">Start a Project</a>\n</section>\n\n<footer>&copy; 2024 Atelier Design Studio. All rights reserved.</footer>\n\n<script>\ndocument.querySelectorAll('a[href^=\"#\"]').forEach(a=>{\n  a.addEventListener('click',e=>{\n    e.preventDefault();\n    const t=document.querySelector(a.getAttribute('href'));\n    if(t)t.scrollIntoView({behavior:'smooth'});\n  });\n});\n\nconst observer=new IntersectionObserver((entries)=>{\n  entries.forEach(e=>{\n    if(e.isIntersecting){\n      e.target.style.opacity='1';\n      e.target.style.transform='translateY(0)';\n    }\n  });\n},{threshold:0.1});\n\ndocument.querySelectorAll('.card,.service-item').forEach(el=>{\n  el.style.opacity='0';\n  el.style.transform='translateY(30px)';\n  el.style.transition='opacity 0.6s ease, transform 0.6s ease';\n  observer.observe(el);\n});\n</script>\n</body>\n</html>"}]}