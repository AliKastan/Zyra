# ── AI Provider Keys ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Deployment ──────────────────────────────────────────────────────────────
# Vercel personal access token — create one at vercel.com/account/tokens
# Required scope: Full Account (or at minimum: Deployments read & write)
VERCEL_TOKEN=

# ── Supabase (server-side, service role) ────────────────────────────────────
# Service role key bypasses RLS — keep secret, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
# Create at stripe.com/dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Webhook signing secret — Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe products (Stripe Dashboard → Products)
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
# Your app's public URL — used for Stripe checkout success/cancel redirects
APP_URL=http://localhost:3001

# ── Model Routing ───────────────────────────────────────────────────────────
DEFAULT_PLANNER_MODEL=claude
DEFAULT_CODER_MODEL=claude
DEFAULT_REVIEW_MODEL=claude

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ── Global job timeout ───────────────────────────────────────────────────────
# MAX_JOB_DURATION_MS=900000   (15 min hard wall — applies to every job)

# ── Generation Limits (optional — safe defaults shown) ──────────────────────
# MAX_PROMPT_CHARS=3000
# MAX_PROMPT_WORDS=500
# MAX_FILES_PER_JOB=20
# MAX_FILE_SIZE_BYTES=153600
# MAX_TOTAL_OUTPUT_BYTES=512000
# MAX_TOTAL_TOKENS_PER_JOB=120000
# MAX_CONCURRENT_JOBS=1
# SIMPLE_MAX_FILES=6
# MEDIUM_MAX_FILES=12

# ── Speed tuning — planner timeouts per complexity tier (ms) ────────────────
# SIMPLE_PLANNER_TIMEOUT_MS=5000    (simple requests skip API — this is a safety cap)
# BALANCED_PLANNER_TIMEOUT_MS=12000
# QUALITY_PLANNER_TIMEOUT_MS=20000

# ── Stage timeouts ───────────────────────────────────────────────────────────
# CODER_TIMEOUT_MS=420000
# REVIEW_TIMEOUT_MS=90000
# FINALIZE_TIMEOUT_MS=60000
