{
  "name": "zyra",
  "version": "0.1.0",
  "description": "Zyra - AI full-stack app builder engine",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "frontend": "npx serve frontend -p 5173",
    "all": "concurrently \"npm run dev\" \"npm run frontend\"",
    "self-heal": "node scripts/self-heal.js",
    "self-heal:dry": "node scripts/self-heal.js --dry-run --verbose",
    "test:debugger": "node test/debugger/classifier.test.js && node test/debugger/auto-fix.test.js",
    "test:inference": "node test/inference/requirements.test.js",
    "test:complexity": "node test/complexity/scorer.test.js",
    "test:multipass": "node test/generation/multipass.test.js",
    "test:file-generator": "node test/file-generator/artifacts.test.js",
    "test:validator": "node test/validator/validator.test.js",
    "test:repair": "node test/repair/repair.test.js",
    "test:packaging": "node test/packaging/packaging.test.js",
    "test:design-system": "node test/design-system/design-system.test.js",
    "test:readiness": "node test/readiness/readiness.test.js",
    "test:error-prevention": "node test/error-prevention/error-prevention.test.js",
    "test:authenticity": "node test/backend-authenticity/backend-authenticity.test.js",
    "test:intent-memory": "node test/intent-memory/intent-memory.test.js",
    "test:ranking": "node test/ranking/ranking.test.js",
    "test:cost-optimizer": "node test/cost-optimizer/cost-optimizer.test.js",
    "test:section-regeneration": "node test/section-regeneration/section-regeneration.test.js",
    "test:business-logic": "node test/business-logic/business-logic.test.js",
    "test:platform-aware": "node test/platform-aware/platform-aware.test.js",
    "test": "node test/inference/requirements.test.js && node test/complexity/scorer.test.js && node test/generation/multipass.test.js && node test/file-generator/artifacts.test.js && node test/validator/validator.test.js && node test/repair/repair.test.js && node test/packaging/packaging.test.js && node test/design-system/design-system.test.js && node test/readiness/readiness.test.js && node test/error-prevention/error-prevention.test.js && node test/backend-authenticity/backend-authenticity.test.js && node test/intent-memory/intent-memory.test.js && node test/ranking/ranking.test.js && node test/cost-optimizer/cost-optimizer.test.js && node test/section-regeneration/section-regeneration.test.js && node test/business-logic/business-logic.test.js && node test/platform-aware/platform-aware.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "archiver": "^7.0.1",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^20.4.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "serve": "^14.2.1"
  }
}
